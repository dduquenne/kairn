{
  "name": "Psypnos Analytics",
  "short_name": "Analytics",
  "description": "Tableau de bord analytics mobile pour Psypnos - Suivez vos statistiques en temps réel",
  "start_url": "/admin/analytics/mobile",
  "display": "standalone",
  "scope": "/admin/analytics/",
