{
  "name": "kairn",
  "version": "0.0.1",
  "private": true,
  "description": "Plateforme mutualisée pour sites de praticiens",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:ui:watch": "vitest --config vitest.ui.config.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:a11y:watch": "vitest --config vitest.a11y.config.ts",
    "test:all": "pnpm test:coverage && pnpm test:ui && pnpm test:a11y",
    "clean": "turbo run clean && rm -rf node_modules .turbo coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "audit": "pnpm audit --audit-level=moderate",
    "prepare": "husky || true",
    "preinstall": "npx only-allow pnpm",
    "check:vercel": "tsx scripts/check-vercel-limits.ts"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^17.4.1",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tsx": "^4.7.0",
    "turbo": "^2.9.4",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tooling/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0"
  }
}
