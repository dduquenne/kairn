# =============================================================================
# KAIRN PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/kairn_db"

# -----------------------------------------------------------------------------
# AUTHENTICATION (generate with: openssl rand -base64 32)
# -----------------------------------------------------------------------------
JWT_SECRET="your-jwt-secret-min-32-characters-here"
JWT_ACCESS_SECRET="your-access-token-secret-here"
JWT_REFRESH_SECRET="your-refresh-token-secret-here"
JWT_PASSWORD_RESET_SECRET="your-password-reset-secret-here"

# -----------------------------------------------------------------------------
# CSRF PROTECTION (generate with: openssl rand -base64 32)
# Must be distinct from JWT_SECRET — never reuse JWT secrets for CSRF
# -----------------------------------------------------------------------------
CSRF_SECRET="your-csrf-secret-min-32-characters-here"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@example.com"
EMAIL_FROM_NAME="Site Name"

# -----------------------------------------------------------------------------
# STORAGE (Supabase - optional)
# -----------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""

# -----------------------------------------------------------------------------
# AI SERVICES (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# JWT SECRETS ENCRYPTION (envelope encryption for secrets stored in DB)
# -----------------------------------------------------------------------------
# Clé de chiffrement des secrets JWT en base de données (générer avec: openssl rand -hex 32)
# Requise en production pour chiffrer les clés de signature JWT au repos
SECRETS_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# SOCIAL MEDIA ENCRYPTION
# -----------------------------------------------------------------------------
SOCIAL_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# ANALYTICS PRIVACY
# -----------------------------------------------------------------------------
# Secret for hashing visitor IP addresses (generate with: openssl rand -base64 32)
IP_HASH_SECRET="your-ip-hash-secret-min-32-characters"

# -----------------------------------------------------------------------------
# CRON JOBS SECURITY
# -----------------------------------------------------------------------------
# Secret pour sécuriser les endpoints CRON (générer avec: openssl rand -base64 32)
CRON_SECRET="your-cron-secret-min-32-characters"

# -----------------------------------------------------------------------------
# QSTASH (Upstash - pour scheduling en production)
# -----------------------------------------------------------------------------
# Token API pour créer/gérer les schedules
QSTASH_TOKEN=""
# Clés de signature pour vérifier les requêtes QStash
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# URL API QStash (optionnel, défaut dans le SDK)
QSTASH_URL="https://qstash.upstash.io"

# -----------------------------------------------------------------------------
# TURBO REMOTE CACHE (pour CI - optionnel en local)
# -----------------------------------------------------------------------------
# Token généré via: npx turbo login && npx turbo link
TURBO_TOKEN=""
# Nom de l'équipe Vercel
TURBO_TEAM=""

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push)
# -----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"
# Admin token for sending notifications (generate with: openssl rand -base64 32)
PUSH_ADMIN_TOKEN=""

# -----------------------------------------------------------------------------
# REDIS (optional — cache & rate limiting)
# -----------------------------------------------------------------------------
# URL de connexion Redis (Upstash, Redis Cloud, etc.)
# Sans Redis, le cache et le rate limiting fonctionnent en mémoire locale
# (non partagé entre instances Serverless — déconseillé en production)
REDIS_URL=""

# -----------------------------------------------------------------------------
# VERCEL DEPLOYMENT TRACKING (admin dashboard)
# -----------------------------------------------------------------------------
# Token API Vercel pour lire les déploiements (Settings > Tokens)
VERCEL_TOKEN=""
# ID du projet Vercel (Settings > General > Project ID)
VERCEL_PROJECT_ID=""
# ID de l'équipe Vercel (optionnel, pour les comptes team)
VERCEL_TEAM_ID=""

# -----------------------------------------------------------------------------
# GITHUB CI TRACKING (admin dashboard)
# -----------------------------------------------------------------------------
# Token GitHub avec accès repo + actions (Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=""
# Repository au format "owner/repo"
GITHUB_REPOSITORY=""

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
