{
  "name": "@kairn/social",
  "version": "0.0.1",
  "private": true,
  "description": "Social media integration module for Kairn sites - OAuth and publishing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./posting": {
      "types": "./dist/posting/index.d.ts",
      "import": "./dist/posting/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairn/config": "workspace:*",
    "@kairn/core": "workspace:*"
  },
  "devDependencies": {
    "@kairn/eslint-config": "workspace:*",
    "@kairn/typescript-config": "workspace:*",
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "social-media",
    "oauth",
    "facebook",
    "instagram",
    "linkedin",
    "twitter",
    "threads",
    "publishing"
  ],
  "author": "Kairn Team",
  "license": "UNLICENSED"
}
