{
  "name": "@kairn/social",
  "version": "0.0.1",
  "private": true,
  "description": "Social media integration module for Kairn sites - OAuth and publishing",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./oauth": {
      "types": "./src/oauth/index.ts",
      "import": "./src/oauth/index.ts",
      "default": "./src/oauth/index.ts"
    },
    "./posting": {
      "types": "./src/posting/index.ts",
      "import": "./src/posting/index.ts",
      "default": "./src/posting/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "import": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./store": {
      "types": "./src/store/index.ts",
      "import": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairn/config": "workspace:*",
    "@kairn/core": "workspace:*"
  },
  "devDependencies": {
    "@kairn/eslint-config": "workspace:*",
    "@kairn/typescript-config": "workspace:*",
    "@types/node": "^25.3.5",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "social-media",
    "oauth",
    "facebook",
    "instagram",
    "linkedin",
    "twitter",
    "threads",
    "publishing"
  ],
  "author": "Kairn Team",
  "license": "UNLICENSED"
}
