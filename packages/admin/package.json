{
  "name": "@kairn/admin",
  "version": "0.0.1",
  "private": true,
  "description": "Dashboard admin pour les sites Kairn",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/layout": {
      "types": "./src/components/layout/index.ts",
      "import": "./src/components/layout/index.ts",
      "default": "./src/components/layout/index.ts"
    },
    "./components/common": {
      "types": "./src/components/common/index.ts",
      "import": "./src/components/common/index.ts",
      "default": "./src/components/common/index.ts"
    },
    "./components/charts": {
      "types": "./src/components/charts/index.ts",
      "import": "./src/components/charts/index.ts",
      "default": "./src/components/charts/index.ts"
    },
    "./components/analytics": {
      "types": "./src/components/analytics/index.ts",
      "import": "./src/components/analytics/index.ts",
      "default": "./src/components/analytics/index.ts"
    },
    "./components/blog": {
      "types": "./src/components/blog/index.ts",
      "import": "./src/components/blog/index.ts",
      "default": "./src/components/blog/index.ts"
    },
    "./components/social": {
      "types": "./src/components/social/index.ts",
      "import": "./src/components/social/index.ts",
      "default": "./src/components/social/index.ts"
    },
    "./components/testimonials": {
      "types": "./src/components/testimonials/index.ts",
      "import": "./src/components/testimonials/index.ts",
      "default": "./src/components/testimonials/index.ts"
    },
    "./components/seminars": {
      "types": "./src/components/seminars/index.ts",
      "import": "./src/components/seminars/index.ts",
      "default": "./src/components/seminars/index.ts"
    },
    "./components/customization": {
      "types": "./src/components/customization/index.ts",
      "import": "./src/components/customization/index.ts",
      "default": "./src/components/customization/index.ts"
    },
    "./components/chatbot": {
      "types": "./src/components/chatbot/index.ts",
      "import": "./src/components/chatbot/index.ts",
      "default": "./src/components/chatbot/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./pages": {
      "types": "./src/pages/index.ts",
      "import": "./src/pages/index.ts",
      "default": "./src/pages/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairn/config": "workspace:*",
    "@kairn/core": "workspace:*",
    "@kairn/ui": "workspace:*",
    "@kairn/analytics": "workspace:*",
    "@kairn/blog": "workspace:*",
    "@kairn/social": "workspace:*",
    "zod": "^3.22.0",
    "@uiw/react-md-editor": "^4.0.11",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.330.0",
    "recharts": "^3.8.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "next": "^14.0.0"
  },
  "devDependencies": {
    "@kairn/typescript-config": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  }
}
