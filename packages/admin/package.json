{
  "name": "@kairn/admin",
  "version": "0.0.1",
  "private": true,
  "description": "Dashboard admin pour les sites Kairn",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js"
    },
    "./components/common": {
      "types": "./dist/components/common/index.d.ts",
      "import": "./dist/components/common/index.js"
    },
    "./components/charts": {
      "types": "./dist/components/charts/index.d.ts",
      "import": "./dist/components/charts/index.js"
    },
    "./components/analytics": {
      "types": "./dist/components/analytics/index.d.ts",
      "import": "./dist/components/analytics/index.js"
    },
    "./components/blog": {
      "types": "./dist/components/blog/index.d.ts",
      "import": "./dist/components/blog/index.js"
    },
    "./components/social": {
      "types": "./dist/components/social/index.d.ts",
      "import": "./dist/components/social/index.js"
    },
    "./components/testimonials": {
      "types": "./dist/components/testimonials/index.d.ts",
      "import": "./dist/components/testimonials/index.js"
    },
    "./components/seminars": {
      "types": "./dist/components/seminars/index.d.ts",
      "import": "./dist/components/seminars/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairn/config": "workspace:*",
    "@kairn/core": "workspace:*",
    "@kairn/ui": "workspace:*",
    "@kairn/analytics": "workspace:*",
    "@kairn/blog": "workspace:*",
    "@kairn/social": "workspace:*",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.563.0",
    "recharts": "^2.12.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "next": "^14.0.0"
  },
  "devDependencies": {
    "@kairn/typescript-config": "workspace:*",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  }
}
