{
  "extends": ["@kairn/eslint-config"],
  "parserOptions": {
    "project": true
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts"],
      "parserOptions": {
        "project": null
      },
      "rules": {
        "@typescript-eslint/no-floating-promises": "off",
        "@typescript-eslint/no-misused-promises": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/"]
}
