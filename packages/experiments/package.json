{
  "name": "@kairn/experiments",
  "version": "0.1.0",
  "private": true,
  "description": "A/B Testing and Experimentation Framework for Kairn Platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "murmurhash3js": "^3.0.1"
  },
  "devDependencies": {
    "@kairn/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@prisma/client": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  }
}
