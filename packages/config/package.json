{
  "name": "@kairn/config",
  "version": "0.0.1",
  "private": true,
  "description": "Types et schémas de configuration pour les sites Kairn",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
