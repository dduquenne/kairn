// =============================================================================
// KAIRN PLATFORM - DATABASE SCHEMA
// =============================================================================
// This schema defines the database structure for the Kairn practitioner platform.
// It supports multi-tenant sites with shared infrastructure.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MULTI-TENANCY: SITES
// =============================================================================

/// Represents a practitioner's website/site in the platform
model Site {
  id        String   @id @default(cuid())
  /// Unique identifier used in configuration (e.g., "psypnos")
  slug      String   @unique
  /// Display name of the site
  name      String
  /// Primary domain for the site
  domain    String   @unique
  /// Whether the site is active
  isActive  Boolean  @default(true)
  /// Site configuration as JSON
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Core
  users        User[]
  blogPosts    BlogPost[]
  testimonials Testimonial[]
  contacts     Contact[]
  seminars     Seminar[]

  // Relations - Analytics
  analyticsEvents          AnalyticsEvent[]
  visitorGeolocations      VisitorGeolocation[]
  analyticsGoals           AnalyticsGoal[]
  analyticsAlerts          AnalyticsAlert[]
  analyticsAnomalies       AnalyticsAnomaly[]
  analyticsDashboardConfigs AnalyticsDashboardConfig[]
  analyticsScheduledReports AnalyticsScheduledReport[]

  @@index([slug])
  @@index([domain])
}

// =============================================================================
// AUTHENTICATION & USERS
// =============================================================================

/// User roles in the system
enum UserRole {
  ADMIN       // Full access to site management
  EDITOR      // Can edit content
  PRACTITIONER // The main practitioner
  USER        // Regular authenticated user
}

/// User account
model User {
  id            String    @id @default(cuid())
  email         String
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  sessions     Session[]
  blogPosts    BlogPost[]    @relation("author")
  refreshTokens RefreshToken[]

  @@unique([email, siteId])
  @@index([email])
  @@index([siteId])
}

/// User session for authentication
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Session token (hashed)
  tokenHash    String   @unique
  /// User agent for session tracking
  userAgent    String?
  /// IP address
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Refresh tokens for JWT rotation
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Token hash (never store plain tokens)
  tokenHash String   @unique
  /// Token family for rotation detection
  family    String
  /// Whether this token has been used (for replay detection)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

// =============================================================================
// SECRETS MANAGEMENT (for JWT rotation)
// =============================================================================

/// Secret key versions for JWT signing
model SecretKey {
  id        String   @id @default(cuid())
  /// Key identifier (kid in JWT header)
  kid       String   @unique
  /// Encrypted secret value
  secret    String
  /// Algorithm used (HS256, HS384, HS512)
  algorithm String   @default("HS256")
  /// Whether this is the current signing key
  isCurrent Boolean  @default(false)
  /// Whether this key can still verify tokens
  isValid   Boolean  @default(true)
  /// When this key was activated
  activatedAt DateTime @default(now())
  /// When this key expires for verification
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([isCurrent])
  @@index([isValid])
}

// =============================================================================
// CONTENT: BLOG
// =============================================================================

/// Blog post status
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Blog post
model BlogPost {
  id          String     @id @default(cuid())
  /// URL-friendly slug
  slug        String
  title       String
  /// Short description for SEO/previews
  excerpt     String?
  /// Full content (Markdown)
  content     String
  /// Featured image URL
  coverImage  String?
  status      PostStatus @default(DRAFT)
  /// SEO meta description
  metaDescription String?
  /// Reading time in minutes
  readingTime Int?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Author
  authorId String
  author   User   @relation("author", fields: [authorId], references: [id])

  // Relations
  tags BlogPostTag[]

  @@unique([slug, siteId])
  @@index([siteId, status])
  @@index([publishedAt])
}

/// Tag for categorizing blog posts
model Tag {
  id        String        @id @default(cuid())
  name      String
  slug      String
  color     String?
  createdAt DateTime      @default(now())
  posts     BlogPostTag[]

  @@unique([slug])
}

/// Many-to-many relation between posts and tags
model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// =============================================================================
// CONTENT: TESTIMONIALS
// =============================================================================

/// Client testimonial
model Testimonial {
  id          String   @id @default(cuid())
  /// Client name (can be anonymized)
  clientName  String
  /// Client initials for anonymized display
  clientInitials String?
  /// Testimonial text
  content     String
  /// Rating out of 5
  rating      Int?
  /// Whether approved for display
  isApproved  Boolean  @default(false)
  /// Display order
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isApproved])
}

// =============================================================================
// CONTACT & LEADS
// =============================================================================

/// Contact form submission status
enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

/// Contact form submission
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  /// Source page
  source    String?
  /// IP address for spam detection
  ipAddress String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([createdAt])
}

// =============================================================================
// ANALYTICS
// =============================================================================

/// Analytics event types - Extended for comprehensive tracking
enum EventType {
  PAGE_VIEW        // Page visit
  PAGE_EXIT        // Page leave with engagement data
  SCROLL_DEPTH     // Scroll milestone reached
  SECTION_VIEW     // Section became visible
  SECTION_TIME     // Time spent on section
  CONVERSION       // Conversion event (appointment, seminar, contact)
  FUNNEL_STEP      // Funnel progression step
  CLICK            // Generic click event
  FORM_SUBMIT      // Form submission
  DOWNLOAD         // File download
  CUSTOM           // Custom event
}

/// Analytics event - Unified event storage
/// All analytics data is stored in this single table with type-specific data in JSON
model AnalyticsEvent {
  id        String    @id @default(cuid())
  type      EventType
  /// Page path where the event occurred
  path      String
  /// Event name/subtype for categorization (e.g., "scroll_25", "appointment_request")
  name      String?
  /// Type-specific event data as JSON
  /// PAGE_VIEW: { referrer, utmSource, utmMedium, utmCampaign, deviceType, browser, os, isBot, isLandingPage }
  /// PAGE_EXIT: { timeOnPage, scrollDepthPercent, engagementScore }
  /// SCROLL_DEPTH: { depth }
  /// SECTION_VIEW: { sectionId, sectionName }
  /// SECTION_TIME: { sectionId, sectionName, timeSpent }
  /// CONVERSION: { conversionType, stepName, completed, value, metadata }
  /// FUNNEL_STEP: { funnelName, stepName, stepOrder, metadata }
  /// CUSTOM: { category, action, label, value, metadata }
  data      Json?
  /// Session identifier (anonymized)
  sessionId String?
  /// User agent string
  userAgent String?
  /// HTTP referrer
  referrer  String?
  /// Country code (from geolocation)
  country   String?
  createdAt DateTime  @default(now())

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Indexes for common query patterns
  @@index([siteId, type, createdAt])
  @@index([siteId, sessionId])
  @@index([siteId, name, createdAt])
  @@index([path])
  @@index([sessionId])
  @@index([createdAt])
}

// =============================================================================
// ANALYTICS: VISITOR GEOLOCATION
// =============================================================================

/// Visitor geolocation data - One record per session
model VisitorGeolocation {
  id          String   @id @default(cuid())
  /// Timestamp of first event in session
  timestamp   DateTime @default(now())
  /// Session identifier (unique per session)
  sessionId   String   @unique
  /// Country name
  country     String
  /// ISO country code
  countryCode String
  /// Region/state name
  region      String?
  /// Region/state code
  regionCode  String?
  /// City name
  city        String?
  /// Latitude coordinate
  latitude    Float?
  /// Longitude coordinate
  longitude   Float?
  /// Timezone identifier
  timezone    String?
  /// Hashed IP address for privacy
  ipAddress   String?

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([siteId, timestamp])
  @@index([country])
}

// =============================================================================
// ANALYTICS: GOALS & OBJECTIVES
// =============================================================================

/// Goal types for tracking
enum GoalType {
  DESTINATION       // User reaches a specific page
  EVENT             // User triggers a specific event
  DURATION          // Session duration threshold
  PAGES_PER_SESSION // Pages viewed per session threshold
}

/// Analytics goal definition
model AnalyticsGoal {
  id              String    @id @default(cuid())
  /// Goal name
  name            String
  /// Goal type
  type            GoalType
  /// Target URL for DESTINATION goals
  destinationUrl  String?
  /// Event category for EVENT goals
  eventCategory   String?
  /// Event action for EVENT goals
  eventAction     String?
  /// Event label for EVENT goals
  eventLabel      String?
  /// Duration threshold in seconds for DURATION goals
  durationSeconds Int?
  /// Comparison operator for numeric goals
  comparison      String?   // "greater_than" | "less_than"
  /// Page count for PAGES_PER_SESSION goals
  pagesCount      Int?
  /// Monetary value attributed to goal completion
  value           Float?
  /// Whether goal is active
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  completions AnalyticsGoalCompletion[]

  @@index([siteId, enabled])
}

/// Goal completion record
model AnalyticsGoalCompletion {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  sessionId String
  goalId    String
  goal      AnalyticsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Value at completion (may differ from goal default)
  value     Float?

  @@index([timestamp])
  @@index([goalId])
  @@index([sessionId])
}

// =============================================================================
// ANALYTICS: ALERTS & MONITORING
// =============================================================================

/// Alert types
enum AlertType {
  THRESHOLD  // Value crosses threshold
  ANOMALY    // Statistical anomaly detected
  TREND      // Trend change detected
}

/// Alert condition operators
enum AlertCondition {
  GREATER_THAN
  LESS_THAN
  EQUALS
  CHANGE_PERCENT
}

/// Alert time windows
enum AlertTimeWindow {
  HOUR
  DAY
  WEEK
  MONTH
}

/// Analytics alert configuration
model AnalyticsAlert {
  id              String           @id @default(cuid())
  /// Alert name
  name            String
  /// Alert description
  description     String?
  /// Alert type
  type            AlertType
  /// Metric to monitor (visits, sessions, conversions, conversion_rate, avg_time, bounce_rate)
  metric          String
  /// Condition for triggering
  condition       AlertCondition
  /// Threshold value
  threshold       Float
  /// Time window for evaluation
  timeWindow      AlertTimeWindow
  /// Notification channels as JSON array ["email", "webhook"]
  channels        Json
  /// Email recipients
  emailRecipients String[]
  /// Webhook URL for notifications
  webhookUrl      String?
  /// Whether alert is active
  enabled         Boolean          @default(true)
  /// Last trigger timestamp
  lastTriggered   DateTime?
  /// Last recorded value
  lastValue       Float?
  /// Total trigger count
  triggerCount    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  history AnalyticsAlertHistory[]

  @@index([siteId, enabled])
}

/// Alert trigger history
model AnalyticsAlertHistory {
  id                String   @id @default(cuid())
  alertId           String
  alert             AnalyticsAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// Alert name at time of trigger
  alertName         String
  triggeredAt       DateTime @default(now())
  /// Metric that triggered
  metric            String
  /// Condition that was met
  condition         String
  /// Threshold value
  threshold         Float
  /// Actual value that triggered
  actualValue       Float
  /// Human-readable message
  message           String
  /// Notification results as JSON
  notificationsSent Json

  @@index([alertId])
  @@index([triggeredAt])
}

/// Detected anomalies
model AnalyticsAnomaly {
  id             String    @id @default(cuid())
  detectedAt     DateTime  @default(now())
  /// Metric with anomaly
  metric         String
  /// Expected value
  expectedValue  Float
  /// Actual value
  actualValue    Float
  /// Deviation from expected (in standard deviations)
  deviation      Float
  /// Severity level (low, medium, high)
  severity       String
  /// Whether anomaly has been acknowledged
  acknowledged   Boolean   @default(false)
  /// Who acknowledged it
  acknowledgedBy String?
  /// When it was acknowledged
  acknowledgedAt DateTime?

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, detectedAt])
  @@index([acknowledged])
}

// =============================================================================
// ANALYTICS: DASHBOARD & REPORTS
// =============================================================================

/// Dashboard configuration
model AnalyticsDashboardConfig {
  id        String   @id @default(cuid())
  /// User who owns this config
  userId    String
  /// Dashboard name
  name      String
  /// Whether this is the default dashboard
  isDefault Boolean  @default(false)
  /// Widget layout as JSON
  widgets   Json
  /// Dashboard settings as JSON
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([siteId, userId])
}

/// Report frequency
enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Scheduled report configuration
model AnalyticsScheduledReport {
  id         String          @id @default(cuid())
  /// Report name
  name       String
  /// Report frequency
  frequency  ReportFrequency
  /// Email recipients
  recipients String[]
  /// Metrics to include as JSON array
  metrics    Json
  /// Report format (pdf, excel, csv)
  format     String          @default("pdf")
  /// Whether report is active
  enabled    Boolean         @default(true)
  /// Last sent timestamp
  lastSentAt DateTime?
  /// Next scheduled send
  nextSendAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, enabled])
  @@index([nextSendAt])
}

// =============================================================================
// SEMINARS & WORKSHOPS
// =============================================================================

/// Seminar/workshop event
model Seminar {
  id          String   @id @default(cuid())
  /// Seminar title
  title       String
  /// Full description
  description String
  /// Speakers/facilitators as JSON array [{firstName, lastName}]
  speakers    Json
  /// Start date and time
  startAt     DateTime
  /// End date and time
  endAt       DateTime
  /// Maximum capacity
  capacity    Int
  /// Price in euros
  price       Decimal? @db.Decimal(10, 2)
  /// Deposit amount
  deposit     Decimal? @db.Decimal(10, 2)
  /// Display order for sorting
  displayOrder String?
  /// Tags for categorization
  tags        String[]
  /// Thumbnail image URL
  thumbnail   String?
  /// Type of seminar (e.g., "respiration", "meditation")
  seminarType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([startAt])
  @@index([siteId, startAt])
}

// =============================================================================
// APPOINTMENTS (Optional feature)
// =============================================================================

/// Appointment status
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Appointment booking
model Appointment {
  id          String            @id @default(cuid())
  /// Client name
  clientName  String
  /// Client email
  clientEmail String
  /// Client phone
  clientPhone String?
  /// Appointment date and time
  startTime   DateTime
  /// End time
  endTime     DateTime
  /// Service type
  serviceType String?
  /// Additional notes
  notes       String?
  status      AppointmentStatus @default(PENDING)
  /// Confirmation token
  confirmToken String?          @unique
  /// Cancellation reason
  cancelReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientEmail])
  @@index([startTime])
  @@index([status])
}
