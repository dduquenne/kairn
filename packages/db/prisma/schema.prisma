// =============================================================================
// KAIRN PLATFORM - DATABASE SCHEMA
// =============================================================================
// This schema defines the database structure for the Kairn practitioner platform.
// It supports multi-tenant sites with shared infrastructure.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MULTI-TENANCY: SITES
// =============================================================================

/// Represents a practitioner's website/site in the platform
model Site {
  id        String   @id @default(cuid())
  /// Unique identifier used in configuration (e.g., "psypnos")
  slug      String   @unique
  /// Display name of the site
  name      String
  /// Primary domain for the site
  domain    String   @unique
  /// Whether the site is active
  isActive  Boolean  @default(true)
  /// Site configuration as JSON
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Core
  users        User[]
  blogPosts    BlogPost[]
  testimonials Testimonial[]
  contacts     Contact[]
  seminars     Seminar[]

  // Relations - Analytics
  analyticsEvents          AnalyticsEvent[]
  analyticsDailySummaries  AnalyticsDailySummary[]
  visitorGeolocations      VisitorGeolocation[]
  analyticsGoals           AnalyticsGoal[]
  analyticsAlerts          AnalyticsAlert[]
  analyticsAnomalies       AnalyticsAnomaly[]
  analyticsDashboardConfigs AnalyticsDashboardConfig[]
  analyticsScheduledReports AnalyticsScheduledReport[]

  // Relations - Chat
  chatConversations ChatConversation[]

  @@index([slug])
  @@index([domain])
}

// =============================================================================
// AUTHENTICATION & USERS
// =============================================================================

/// User roles in the system
enum UserRole {
  ADMIN       // Full access to site management
  EDITOR      // Can edit content
  PRACTITIONER // The main practitioner
  USER        // Regular authenticated user
}

/// User account
model User {
  id            String    @id @default(cuid())
  email         String
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  sessions     Session[]
  blogPosts    BlogPost[]    @relation("author")
  refreshTokens RefreshToken[]

  @@unique([email, siteId])
  @@index([email])
  @@index([siteId])
}

/// User session for authentication
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Session token (hashed)
  tokenHash    String   @unique
  /// User agent for session tracking
  userAgent    String?
  /// IP address
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Refresh tokens for JWT rotation
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Token hash (never store plain tokens)
  tokenHash String   @unique
  /// Token family for rotation detection
  family    String
  /// Whether this token has been used (for replay detection)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

// =============================================================================
// SECRETS MANAGEMENT (for JWT rotation)
// =============================================================================

/// Secret key versions for JWT signing
model SecretKey {
  id        String   @id @default(cuid())
  /// Key identifier (kid in JWT header)
  kid       String   @unique
  /// Encrypted secret value
  secret    String
  /// Algorithm used (HS256, HS384, HS512)
  algorithm String   @default("HS256")
  /// Whether this is the current signing key
  isCurrent Boolean  @default(false)
  /// Whether this key can still verify tokens
  isValid   Boolean  @default(true)
  /// When this key was activated
  activatedAt DateTime @default(now())
  /// When this key expires for verification
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([isCurrent])
  @@index([isValid])
}

// =============================================================================
// CONTENT: BLOG
// =============================================================================

/// Blog post status
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Blog post
model BlogPost {
  id          String     @id @default(cuid())
  /// URL-friendly slug
  slug        String
  title       String
  /// Short description for SEO/previews
  excerpt     String?
  /// Full content (Markdown)
  content     String
  /// Featured image URL
  coverImage  String?
  status      PostStatus @default(DRAFT)
  /// SEO meta description
  metaDescription String?
  /// Reading time in minutes
  readingTime Int?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // === Extended fields (from BlogPostExtended) ===
  /// Article category (e.g., "Comprendre", "Traverser")
  category    String?
  /// AI image generation prompt
  imagePrompt String?
  /// SEO intent/keyword target
  seoIntent   String?
  /// Target reader persona description
  persona     String?
  /// Content tones used (e.g., ["pédagogique", "apaisant"])
  tones       String[]   @default([])
  /// FAQ section as JSON array [{question, answer, id?}]
  faq         Json?
  /// Structured data JSON-LD for SEO
  jsonLd      Json?
  /// Featured article (shown prominently)
  featured    Boolean    @default(false)
  /// Fallback author name (for articles without User relation)
  authorName  String?

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Author (optional for migration compatibility)
  authorId String?
  author   User?   @relation("author", fields: [authorId], references: [id])

  // Relations
  tags BlogPostTag[]

  @@unique([slug, siteId])
  @@index([siteId, status])
  @@index([publishedAt])
  @@index([siteId, featured])
  @@index([category])
}

/// Tag for categorizing blog posts
model Tag {
  id        String        @id @default(cuid())
  name      String
  slug      String
  color     String?
  createdAt DateTime      @default(now())
  posts     BlogPostTag[]

  @@unique([slug])
}

/// Many-to-many relation between posts and tags
model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// =============================================================================
// CONTENT: TESTIMONIALS
// =============================================================================

/// Client testimonial
model Testimonial {
  id          String   @id @default(cuid())
  /// Client name (can be anonymized)
  clientName  String
  /// Client initials for anonymized display
  clientInitials String?
  /// Testimonial text
  content     String
  /// Rating out of 5
  rating      Int?
  /// Whether approved for display
  isApproved  Boolean  @default(false)
  /// Display order
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isApproved])
}

// =============================================================================
// CONTACT & LEADS
// =============================================================================

/// Contact form submission status
enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

/// Contact form submission
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  /// Source page
  source    String?
  /// IP address for spam detection
  ipAddress String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([createdAt])
}

// =============================================================================
// ANALYTICS
// =============================================================================

/// Analytics event types - Extended for comprehensive tracking
enum EventType {
  PAGE_VIEW        // Page visit
  PAGE_EXIT        // Page leave with engagement data
  SCROLL_DEPTH     // Scroll milestone reached
  SECTION_VIEW     // Section became visible
  SECTION_TIME     // Time spent on section
  CONVERSION       // Conversion event (appointment, seminar, contact)
  FUNNEL_STEP      // Funnel progression step
  CLICK            // Generic click event
  FORM_SUBMIT      // Form submission
  DOWNLOAD         // File download
  CUSTOM           // Custom event
  SESSION_START    // Session start
  SESSION_END      // Session end with duration and page count
}

/// Analytics event - Unified event storage
/// All analytics data is stored in this single table with type-specific data in JSON
model AnalyticsEvent {
  id        String    @id @default(cuid())
  type      EventType
  /// Page path where the event occurred
  path      String
  /// Event name/subtype for categorization (e.g., "scroll_25", "appointment_request")
  name      String?
  /// Type-specific event data as JSON
  /// PAGE_VIEW: { referrer, utmSource, utmMedium, utmCampaign, deviceType, browser, os, isBot, isLandingPage }
  /// PAGE_EXIT: { timeOnPage, scrollDepthPercent, engagementScore }
  /// SCROLL_DEPTH: { depth }
  /// SECTION_VIEW: { sectionId, sectionName }
  /// SECTION_TIME: { sectionId, sectionName, timeSpent }
  /// CONVERSION: { conversionType, stepName, completed, value, metadata }
  /// FUNNEL_STEP: { funnelName, stepName, stepOrder, metadata }
  /// CUSTOM: { category, action, label, value, metadata }
  data      Json?
  /// Session identifier (anonymized)
  sessionId String?
  /// User agent string
  userAgent String?
  /// HTTP referrer
  referrer  String?
  /// Country code (from geolocation)
  country   String?
  createdAt DateTime  @default(now())

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Indexes for common query patterns
  @@index([siteId, type, createdAt])
  @@index([siteId, sessionId])
  @@index([siteId, name, createdAt])
  @@index([siteId, path, createdAt])
  @@index([siteId, createdAt])
}

/// Pre-computed daily analytics summary for fast dashboard queries
model AnalyticsDailySummary {
  id              String   @id @default(cuid())
  /// Date for this summary (without time)
  date            DateTime @db.Date
  /// Total page views for the day
  pageViews       Int      @default(0)
  /// Unique visitors (distinct sessions)
  uniqueVisitors  Int      @default(0)
  /// Total sessions started
  sessions        Int      @default(0)
  /// Bounce rate (% of single-page sessions)
  bounceRate      Float    @default(0)
  /// Average time on site in milliseconds
  avgTimeOnSite   Float    @default(0)
  /// Top pages with view counts (JSON array)
  topPages        Json?
  /// Top traffic sources with visit counts (JSON array)
  topSources      Json?
  /// Device breakdown (JSON object)
  deviceBreakdown Json?
  /// Conversion counts by type (JSON object)
  conversions     Json?

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
}

// =============================================================================
// ANALYTICS: VISITOR GEOLOCATION
// =============================================================================

/// Visitor geolocation data - One record per session
model VisitorGeolocation {
  id          String   @id @default(cuid())
  /// Timestamp of first event in session
  timestamp   DateTime @default(now())
  /// Session identifier (unique per session)
  sessionId   String   @unique
  /// Country name
  country     String
  /// ISO country code
  countryCode String
  /// Region/state name (required for multi-tenant isolation)
  region      String?
  /// Region/state code
  regionCode  String?
  /// City name
  city        String?
  /// Latitude coordinate
  latitude    Float?
  /// Longitude coordinate
  longitude   Float?
  /// Timezone identifier
  timezone    String?
  /// Hashed IP address for privacy
  ipAddress   String?

  // Multi-tenancy (required for data isolation)
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([siteId, timestamp])
  @@index([country])
}

// =============================================================================
// ANALYTICS: GOALS & OBJECTIVES
// =============================================================================

/// Goal types for tracking
enum GoalType {
  DESTINATION       // User reaches a specific page
  EVENT             // User triggers a specific event
  DURATION          // Session duration threshold
  PAGES_PER_SESSION // Pages viewed per session threshold
}

/// Analytics goal definition
model AnalyticsGoal {
  id              String    @id @default(cuid())
  /// Goal name
  name            String
  /// Goal type
  type            GoalType
  /// Target URL for DESTINATION goals
  destinationUrl  String?
  /// Event category for EVENT goals
  eventCategory   String?
  /// Event action for EVENT goals
  eventAction     String?
  /// Event label for EVENT goals
  eventLabel      String?
  /// Duration threshold in seconds for DURATION goals
  durationSeconds Int?
  /// Comparison operator for numeric goals
  comparison      String?   // "greater_than" | "less_than"
  /// Page count for PAGES_PER_SESSION goals
  pagesCount      Int?
  /// Monetary value attributed to goal completion
  value           Float?
  /// Whether goal is active
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  completions AnalyticsGoalCompletion[]

  @@index([siteId, enabled])
}

/// Goal completion record
model AnalyticsGoalCompletion {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  sessionId String
  goalId    String
  goal      AnalyticsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Value at completion (may differ from goal default)
  value     Float?

  @@index([timestamp])
  @@index([goalId])
  @@index([sessionId])
}

// =============================================================================
// ANALYTICS: ALERTS & MONITORING
// =============================================================================

/// Alert types
enum AlertType {
  THRESHOLD  // Value crosses threshold
  ANOMALY    // Statistical anomaly detected
  TREND      // Trend change detected
}

/// Alert condition operators
enum AlertCondition {
  GREATER_THAN
  LESS_THAN
  EQUALS
  CHANGE_PERCENT
}

/// Alert time windows
enum AlertTimeWindow {
  HOUR
  DAY
  WEEK
  MONTH
}

/// Analytics alert configuration
model AnalyticsAlert {
  id              String           @id @default(cuid())
  /// Alert name
  name            String
  /// Alert description
  description     String?
  /// Alert type
  type            AlertType
  /// Metric to monitor (visits, sessions, conversions, conversion_rate, avg_time, bounce_rate)
  metric          String
  /// Condition for triggering
  condition       AlertCondition
  /// Threshold value
  threshold       Float
  /// Time window for evaluation
  timeWindow      AlertTimeWindow
  /// Notification channels as JSON array ["email", "webhook"]
  channels        Json
  /// Email recipients
  emailRecipients String[]
  /// Webhook URL for notifications
  webhookUrl      String?
  /// Whether alert is active
  enabled         Boolean          @default(true)
  /// Last trigger timestamp
  lastTriggered   DateTime?
  /// Last recorded value
  lastValue       Float?
  /// Total trigger count
  triggerCount    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  history AnalyticsAlertHistory[]

  @@index([siteId, enabled])
}

/// Alert trigger history
model AnalyticsAlertHistory {
  id                String   @id @default(cuid())
  alertId           String
  alert             AnalyticsAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// Alert name at time of trigger
  alertName         String
  triggeredAt       DateTime @default(now())
  /// Metric that triggered
  metric            String
  /// Condition that was met
  condition         String
  /// Threshold value
  threshold         Float
  /// Actual value that triggered
  actualValue       Float
  /// Human-readable message
  message           String
  /// Notification results as JSON
  notificationsSent Json

  @@index([alertId])
  @@index([triggeredAt])
}

/// Detected anomalies
model AnalyticsAnomaly {
  id             String    @id @default(cuid())
  detectedAt     DateTime  @default(now())
  /// Metric with anomaly
  metric         String
  /// Expected value
  expectedValue  Float
  /// Actual value
  actualValue    Float
  /// Deviation from expected (in standard deviations)
  deviation      Float
  /// Severity level (low, medium, high)
  severity       String
  /// Whether anomaly has been acknowledged
  acknowledged   Boolean   @default(false)
  /// Who acknowledged it
  acknowledgedBy String?
  /// When it was acknowledged
  acknowledgedAt DateTime?

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, detectedAt])
  @@index([acknowledged])
}

// =============================================================================
// ANALYTICS: DASHBOARD & REPORTS
// =============================================================================

/// Dashboard configuration
model AnalyticsDashboardConfig {
  id        String   @id @default(cuid())
  /// User who owns this config
  userId    String
  /// Dashboard name
  name      String
  /// Whether this is the default dashboard
  isDefault Boolean  @default(false)
  /// Widget layout as JSON
  widgets   Json
  /// Dashboard settings as JSON
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([siteId, userId])
}

/// Report frequency
enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Scheduled report configuration
model AnalyticsScheduledReport {
  id         String          @id @default(cuid())
  /// Report name
  name       String
  /// Report frequency
  frequency  ReportFrequency
  /// Email recipients
  recipients String[]
  /// Metrics to include as JSON array
  metrics    Json
  /// Report format (pdf, excel, csv)
  format     String          @default("pdf")
  /// Whether report is active
  enabled    Boolean         @default(true)
  /// Last sent timestamp
  lastSentAt DateTime?
  /// Next scheduled send
  nextSendAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Multi-tenancy
  siteId String?
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, enabled])
  @@index([nextSendAt])
}

// =============================================================================
// SEMINARS & WORKSHOPS
// =============================================================================

/// Seminar/workshop event
model Seminar {
  id          String   @id @default(cuid())
  /// Seminar title
  title       String
  /// Full description
  description String
  /// Speakers/facilitators as JSON array [{firstName, lastName}]
  speakers    Json
  /// Start date and time
  startAt     DateTime
  /// End date and time
  endAt       DateTime
  /// Maximum capacity
  capacity    Int
  /// Price in euros
  price       Decimal? @db.Decimal(10, 2)
  /// Deposit amount
  deposit     Decimal? @db.Decimal(10, 2)
  /// Display order for sorting
  displayOrder String?
  /// Tags for categorization
  tags        String[]
  /// Thumbnail image URL
  thumbnail   String?
  /// Type of seminar (e.g., "respiration", "meditation")
  seminarType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([startAt])
  @@index([siteId, startAt])
}

// =============================================================================
// APPOINTMENTS (Optional feature)
// =============================================================================

/// Appointment status
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Appointment booking
model Appointment {
  id          String            @id @default(cuid())
  /// Client name
  clientName  String
  /// Client email
  clientEmail String
  /// Client phone
  clientPhone String?
  /// Appointment date and time
  startTime   DateTime
  /// End time
  endTime     DateTime
  /// Service type
  serviceType String?
  /// Additional notes
  notes       String?
  status      AppointmentStatus @default(PENDING)
  /// Confirmation token
  confirmToken String?          @unique
  /// Cancellation reason
  cancelReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientEmail])
  @@index([startTime])
  @@index([status])
}

// =============================================================================
// BLOG: EXTENDED CONTENT MODEL (Psypnos-style)
// =============================================================================

/// Extended blog post model with full content management features
/// This extends the base BlogPost for sites that need richer blog functionality
model BlogPostExtended {
  id           String   @id @default(cuid())
  /// URL-friendly slug
  slug         String   @unique
  title        String
  /// Short description for SEO/previews
  description  String?
  /// Full content (Markdown/HTML)
  content      String
  /// Author name
  author       String
  /// Category for organization
  category     String
  /// Tags as string array
  tags         String[]
  /// Cover/featured image URL
  image        String?
  /// AI image generation prompt used
  imagePrompt  String?
  /// SEO intent/keyword
  seoIntent    String?
  /// Target reader persona
  persona      String?
  /// Content tones used
  tones        String[]
  /// FAQ section as JSON array [{question, answer, id?}]
  faq          Json?
  /// Structured data JSON-LD
  jsonLd       Json?
  /// Whether published
  published    Boolean  @default(false)
  /// Whether featured on homepage
  featured     Boolean  @default(false)
  /// Publication date
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, date])
  @@index([category])
  @@index([featured])
}

// =============================================================================
// BLOG: ANALYTICS & ENGAGEMENT TRACKING
// =============================================================================

/// Blog article view/engagement tracking
model BlogAnalytics {
  id                String   @id @default(cuid())
  /// Article slug being tracked
  articleSlug       String
  /// Visitor session identifier
  sessionId         String
  /// Event timestamp
  timestamp         DateTime @default(now())
  /// Scroll depth percentage reached
  scrollDepthPercent Int?
  /// Time spent on page in seconds
  timeOnPage        Int?
  /// Whether the article was fully read
  completed         Boolean  @default(false)

  @@index([articleSlug])
  @@index([timestamp])
  @@index([sessionId])
}

/// FAQ accordion click tracking
model BlogFaqClick {
  id          String   @id @default(cuid())
  /// Event timestamp
  timestamp   DateTime @default(now())
  /// Article slug
  articleSlug String
  /// Visitor session identifier
  sessionId   String
  /// FAQ item index (0-based)
  faqIndex    Int
  /// FAQ question text (for reporting)
  question    String?

  @@index([articleSlug])
  @@index([timestamp])
}

/// CTA button click tracking (appointment, seminar)
model BlogCtaClick {
  id          String   @id @default(cuid())
  /// Article slug where click occurred
  articleSlug String
  /// CTA type: "appointment" or "seminar"
  ctaType     String
  /// Visitor session identifier
  sessionId   String
  /// Event timestamp
  timestamp   DateTime @default(now())

  @@index([articleSlug])
  @@index([ctaType])
  @@index([timestamp])
}

// =============================================================================
// BLOG: AI GENERATION JOBS
// =============================================================================

/// Blog generation job status
enum BlogJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Async blog article generation job
model BlogGenerationJob {
  id          String        @id @default(uuid())
  /// Job status
  status      BlogJobStatus @default(PENDING)
  /// Progress percentage (0-100)
  progress    Int           @default(0)
  /// Current step description
  currentStep String?
  /// Total number of steps
  totalSteps  Int           @default(9)
  /// Input parameters as JSON
  input       Json
  /// Generated result as JSON (article content)
  result      Json?
  /// Error message if failed
  error       String?
  /// When processing started
  startedAt   DateTime?
  /// When processing completed
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  /// When the job result was used to create an article
  usedAt      DateTime?
  /// Slug of created article (for duplicate prevention)
  articleSlug String?

  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// BOT & CRAWLER TRACKING
// =============================================================================

/// Bot/crawler visit tracking for SEO monitoring
model BotVisit {
  id          String   @id @default(cuid())
  /// Visit timestamp
  timestamp   DateTime @default(now())
  /// Bot name (e.g., "Googlebot", "Bingbot")
  botName     String
  /// Bot type category
  botType     String   // "search_engine", "social", "seo_tool", "monitor", "other"
  /// Full user agent string
  userAgent   String?
  /// Page path visited
  page        String
  /// HTTP referrer
  referrer    String?
  /// HTTP method
  method      String   @default("GET")
  /// Response status code
  statusCode  Int?
  /// Country name
  country     String?
  /// Country ISO code
  countryCode String?
  /// City name
  city        String?
  /// Hashed IP for privacy
  ipHash      String?

  @@index([timestamp])
  @@index([botName])
  @@index([botType])
  @@index([page])
}

// =============================================================================
// SOCIAL MEDIA MANAGEMENT
// =============================================================================

/// Social media platform
enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  THREADS
}

/// Social media account connection
model SocialAccount {
  id            String         @id @default(cuid())
  /// Platform identifier
  platform      SocialPlatform
  /// Platform-specific account ID
  platformId    String
  /// Display name
  accountName   String
  /// Profile image URL
  profileImage  String?
  /// OAuth access token (encrypted)
  accessToken   String
  /// OAuth refresh token (encrypted)
  refreshToken  String?
  /// Token expiration timestamp
  tokenExpiresAt DateTime?
  /// Platform-specific metadata as JSON
  metadata      Json?
  /// Whether account is active
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  posts     SocialPost[]
  snapshots SocialAccountSnapshot[]

  @@unique([platform, platformId])
  @@index([platform])
  @@index([isActive])
}

/// Social post status
enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

/// Social media post
model SocialPost {
  id             String           @id @default(cuid())
  /// Target platform
  platform       SocialPlatform
  /// Post content/caption
  content        String
  /// Associated blog post title (if any)
  blogTitle      String?
  /// Associated blog post slug (if any)
  blogSlug       String?
  /// Media URLs as JSON array
  mediaUrls      Json?
  /// Hashtags as JSON array
  hashtags       Json?
  /// Link URL included in the post
  linkUrl        String?
  /// Post status
  status         SocialPostStatus @default(DRAFT)
  /// Scheduled publication time
  scheduledAt    DateTime?
  /// Actual publication time
  publishedAt    DateTime?
  /// Platform-specific post ID after publishing
  externalPostId String?
  /// Direct link to view published post on the platform
  platformUrl    String?
  /// Error message if failed
  errorMessage   String?
  /// Retry count for failed posts
  retryCount     Int              @default(0)
  /// Content generation source ('ai' or 'manual')
  generatedBy    String?
  /// AI prompt used for generation
  aiPrompt       String?          @db.Text
  /// AI model used for generation
  aiModel        String?
  /// Platform-specific metadata as JSON
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  accountId String
  account   SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  analytics SocialPostAnalytics?

  @@index([platform, status])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([accountId])
}

/// Social post performance analytics
model SocialPostAnalytics {
  id          String     @id @default(cuid())
  postId      String     @unique
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Number of times shown
  impressions Int        @default(0)
  /// Unique accounts reached
  reach       Int        @default(0)
  /// Total engagements (likes + comments + shares + saves)
  engagements Int        @default(0)
  /// Like/reaction count
  likes       Int        @default(0)
  /// Comment count
  comments    Int        @default(0)
  /// Share/retweet count
  shares      Int        @default(0)
  /// Save/bookmark count
  saves       Int        @default(0)
  /// Link click count
  clicks      Int        @default(0)
  /// Raw API response data
  rawData     Json?
  /// Last sync timestamp
  lastSyncAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([lastSyncAt])
}

/// Daily snapshot of social account metrics (followers, following, etc.)
model SocialAccountSnapshot {
  id          String         @id @default(cuid())
  accountId   String
  account     SocialAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Platform for quick filtering without join
  platform    SocialPlatform
  /// Follower count at snapshot time
  followers   Int            @default(0)
  /// Following count at snapshot time
  following   Int            @default(0)
  /// Total posts count on the platform
  postsCount  Int            @default(0)
  /// Raw platform-specific metrics as JSON
  rawMetrics  Json?
  /// Snapshot date (truncated to day for dedup)
  snapshotDate DateTime
  createdAt    DateTime      @default(now())

  @@unique([accountId, snapshotDate])
  @@index([platform, snapshotDate])
  @@index([accountId, snapshotDate])
}

// =============================================================================
// DEPLOYMENT & MAINTENANCE
// =============================================================================

/// Deployment record
model Deployment {
  id                String    @id @default(cuid())
  /// Deployment status (pending, in_progress, success, failed, cancelled, rolled_back)
  status            String    @default("pending")
  /// Git branch/tag being deployed
  targetRef         String?
  /// Target commit SHA
  targetCommit      String?
  /// Previous commit SHA for rollback
  previousCommit    String?
  /// User who triggered deployment
  triggeredBy       String
  /// When deployment was triggered
  triggeredAt       DateTime  @default(now())
  /// When deployment started
  startedAt         DateTime?
  /// When deployment completed
  completedAt       DateTime?
  /// Current deployment phase
  currentPhase      String?
  /// Progress percentage (0-100)
  progress          Int       @default(0)
  /// Error message if failed
  errorMessage      String?
  /// Whether health check passed
  healthCheckPassed Boolean?
  /// When rolled back
  rolledBackAt      DateTime?
  /// Reason for rollback
  rollbackReason    String?
  /// One-time deploy token for scripts
  deployToken       String?   @unique
  /// Token expiration
  tokenExpiresAt    DateTime?
  /// Build logs
  logs              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([triggeredAt])
  @@index([targetRef])
}

/// Maintenance mode singleton
model MaintenanceMode {
  id           String    @id @default("singleton")
  /// Whether maintenance mode is active
  isActive     Boolean   @default(false)
  /// Reason for maintenance
  reason       String?
  /// Public message to display
  message      String?
  /// Who activated maintenance
  activatedBy  String?
  /// When activated
  activatedAt  DateTime?
  /// Estimated end time
  estimatedEnd DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// =============================================================================
// PUSH NOTIFICATIONS
// =============================================================================

/// Push notification subscription
model PushSubscription {
  id           String   @id @default(cuid())
  /// Web Push endpoint URL
  endpoint     String   @unique
  /// Auth key (encrypted)
  auth         String
  /// P256DH key (encrypted)
  p256dh       String
  /// User agent for tracking
  userAgent    String?
  /// Device type (mobile, desktop, tablet)
  deviceType   String?
  /// Subscription topics (e.g., "blog", "seminars", "offers")
  topics       String[] @default(["all"])
  /// Whether subscription is active
  isActive     Boolean  @default(true)
  /// Last successful push timestamp
  lastPushAt   DateTime?
  /// Number of failed push attempts
  failCount    Int      @default(0)
  /// Session ID for correlation
  sessionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([topics])
  @@index([sessionId])
}

/// Push notification log
model PushNotificationLog {
  id            String   @id @default(cuid())
  /// Notification title
  title         String
  /// Notification body
  body          String
  /// Target URL when clicked
  url           String?
  /// Notification type (blog, seminar, offer, system)
  type          String
  /// Topic targeted
  topic         String   @default("all")
  /// Total subscriptions targeted
  targetCount   Int      @default(0)
  /// Successful deliveries
  successCount  Int      @default(0)
  /// Failed deliveries
  failCount     Int      @default(0)
  /// Who triggered the notification
  triggeredBy   String?
  /// Additional metadata
  metadata      Json?
  sentAt        DateTime @default(now())

  @@index([type])
  @@index([sentAt])
}

// =============================================================================
// CHAT / CONVERSATIONS
// =============================================================================

/// Chat conversation for FAQ chatbot
model ChatConversation {
  id         String        @id @default(cuid())
  /// Session identifier
  sessionId  String
  /// User's IP hash for analytics
  ipHash     String?
  /// Conversation status
  status     String        @default("active") // active, ended, transferred
  /// Number of messages
  messageCount Int         @default(0)
  /// Whether user was satisfied (feedback)
  satisfied  Boolean?
  /// Referrer page
  referrer   String?
  /// Device type
  deviceType String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  endedAt    DateTime?

  // Multi-tenancy
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Relations
  messages   ChatMessage[]

  @@index([siteId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([status])
}

/// Chat message
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Message role (user, assistant, system)
  role           String
  /// Message content
  content        String
  /// Tokens used (for cost tracking)
  tokensUsed     Int?
  /// Processing time in ms
  processingTime Int?
  /// Suggested actions from this message
  suggestedActions Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// =============================================================================
// A/B TESTING / EXPERIMENTS
// =============================================================================

/// Experiment definition
model Experiment {
  id          String   @id @default(cuid())
  /// Experiment name (e.g., "cta-color-test")
  name        String   @unique
  /// Description
  description String?
  /// Experiment status
  status      String   @default("draft") // draft, running, paused, completed
  /// Traffic percentage (0-100)
  trafficPercent Int   @default(100)
  /// Start date
  startedAt   DateTime?
  /// End date
  endedAt     DateTime?
  /// Winning variant ID
  winningVariant String?
  /// Statistical significance reached
  significanceReached Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  variants    ExperimentVariant[]
  assignments ExperimentAssignment[]

  @@index([status])
  @@index([name])
}

/// Experiment variant
model ExperimentVariant {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  /// Variant name (e.g., "control", "variant-a")
  name         String
  /// Traffic weight (relative)
  weight       Int        @default(1)
  /// Variant configuration as JSON
  config       Json
  /// Whether this is the control variant
  isControl    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // Relations
  assignments ExperimentAssignment[]
  results     ExperimentResult[]

  @@unique([experimentId, name])
  @@index([experimentId])
}

/// User assignment to experiment variant
model ExperimentAssignment {
  id           String            @id @default(cuid())
  experimentId String
  experiment   Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Session or user identifier
  sessionId    String
  /// IP hash for consistency
  ipHash       String?
  assignedAt   DateTime          @default(now())

  @@unique([experimentId, sessionId])
  @@index([experimentId])
  @@index([variantId])
  @@index([sessionId])
}

/// Experiment results/conversions
model ExperimentResult {
  id          String            @id @default(cuid())
  variantId   String
  variant     ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Session identifier
  sessionId   String
  /// Metric name (e.g., "click", "conversion", "time_on_page")
  metric      String
  /// Metric value
  value       Float             @default(1)
  /// Additional metadata
  metadata    Json?
  recordedAt  DateTime          @default(now())

  @@index([variantId])
  @@index([metric])
  @@index([recordedAt])
}

// =============================================================================
// SMART FORM PREFILL
// =============================================================================

/// User navigation history for smart prefill (with consent)
model NavigationHistory {
  id           String   @id @default(cuid())
  /// Session identifier
  sessionId    String
  /// Pages visited as JSON array
  pagesVisited Json
  /// Time spent per page as JSON
  timePerPage  Json?
  /// Inferred interests based on navigation
  interests    String[] @default([])
  /// Suggested service
  suggestedService String?
  /// Consent given for tracking
  consentGiven Boolean  @default(false)
  /// Consent timestamp
  consentAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sessionId])
  @@index([sessionId])
  @@index([suggestedService])
}
